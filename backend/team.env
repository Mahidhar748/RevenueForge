# Settings shared by the whole team through git. NOT for secrets.
# Only GOOGLE_CLIENT_ID and GOOGLE_ALLOWED_DOMAINS are read from this file; anything else here is ignored.
# API keys (Gemini etc.) go in your own backend/.env, which is never committed.
# A value in your own backend/.env overrides the one here.

# "Sign in with Google". The OAuth client ID is public by design (every visitor's browser receives it).
# New teammates must be added as test users in Google Cloud Console > Google Auth Platform > Audience.
GOOGLE_CLIENT_ID=402213995901-e2ogke4bfb75ioqlfvadc6llmgrch764.apps.googleusercontent.com

# Optional: only allow these email domains to sign in with Google, e.g. yourcompany.com. Empty = any verified Google account.
GOOGLE_ALLOWED_DOMAINS=
